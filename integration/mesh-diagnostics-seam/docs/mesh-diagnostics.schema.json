          "maxLength": 256,
          "minLength": 1,
          "title": "Geometry Revision",
          "type": "string"
        },
        "kind": {
          "const": "edges",
          "default": "edges",
          "title": "Kind",
          "type": "string"
        },
        "indices": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 3000000,
          "title": "Indices",
          "type": "array"
        }
      },
      "required": [
        "id",
        "geometry_revision",
        "indices"
      ],
      "title": "EdgeTarget",
      "type": "object"
    },
    "FaceTarget": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "geometry_revision": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Geometry Revision",
          "type": "string"
        },
        "kind": {
          "const": "faces",
          "default": "faces",
          "title": "Kind",
          "type": "string"
        },
        "ids": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 500000,
          "title": "Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "geometry_revision",
        "ids"
      ],
      "title": "FaceTarget",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "status": {
          "enum": [
            "info",
            "pass",
            "warn",
            "fail",
            "not_checked"
          ],
          "title": "Status",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 4096,
          "title": "Description",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        }
      },
      "required": [
        "id",
        "label",
        "value",
        "status"
      ],
      "title": "Metric",
      "type": "object"
    },
    "SegmentTarget": {
      "additionalProperties": false,
      "description": "Unclassified WORLD-space segments, chiefly for legacy payload adaptation.",
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "geometry_revision": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Geometry Revision",
          "type": "string"
        },
        "kind": {
          "const": "segments",
          "default": "segments",
          "title": "Kind",
          "type": "string"
        },
        "positions": {
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ]
